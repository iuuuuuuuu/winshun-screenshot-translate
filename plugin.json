{
  "manifest": 1,
  "id": "iuuuuuuuu.screenshot-translate",
  "name": {
    "zh": "截图翻译",
    "en": "Screenshot Translate"
  },
  "version": "0.4.2",
  "settingsWindow": true,
  "description": {
    "zh": "无需 Python 的原生截图、剪贴板、划词和鼠标指词翻译；支持可编辑原文、固定跟随、管理员选区及渠道自动降级。",
    "en": "Native screenshot, clipboard, selection and pointer OCR translation, with editable source, pinned following, elevated selection access and service fallback."
  },
  "author": "iuuuuuuuu",
  "homepage": "https://github.com/iuuuuuuuu/winshun-screenshot-translate",
  "license": "MIT",
  "minWinShun": "0.22.0",
  "runtime": {
    "mode": "resident",
    "program": "ScreenshotTranslate.exe",
    "start": "eager",
    "sandbox": "normal",
    "timeoutMs": 25000,
    "debounceMs": 300,
    "idleExitSec": 0,
    "memoryMB": 1024
  },
  "permissions": [
    "ui",
    "clipboard:read",
    "clipboard:write",
    "network",
    "files:write",
    "processes",
    "elevated"
  ],
  "commands": [
    {
      "id": "shot",
      "title": {
        "zh": "截图翻译",
        "en": "Screenshot translate"
      },
      "description": {
        "zh": "框选屏幕区域，识别文字并翻译；不用鼠标时可选全屏或当前窗口。",
        "en": "Select a screen region, recognize the text, and translate it; full screen or the active window work without the mouse."
      },
      "hint": {
        "zh": "Enter 框选区域，Ctrl+Enter 全屏，Shift+Enter 当前窗口",
        "en": "Enter selects a region, Ctrl+Enter uses the full screen, Shift+Enter the active window"
      },
      "icon": "glyph:U+E8C1",
      "keyword": [
        "jst",
        "截图翻译"
      ],
      "mode": "list",
      "actions": [
        {
          "id": "start-region",
          "title": {
            "zh": "框选区域",
            "en": "Select a region"
          },
          "key": "Enter"
        },
        {
          "id": "start-full",
          "title": {
            "zh": "全屏",
            "en": "Full screen"
          },
          "key": "Ctrl+Enter"
        },
        {
          "id": "start-window",
          "title": {
            "zh": "当前窗口",
            "en": "Active window"
          },
          "key": "Shift+Enter"
        }
      ]
    },
    {
      "id": "jsel",
      "title": {
        "zh": "划词翻译",
        "en": "Selection translate"
      },
      "description": {
        "zh": "读取当前窗口里选中的文字并翻译；不使用鼠标钩子，也不模拟按键。",
        "en": "Reads the text selected in the active window and translates it; no mouse hook and no simulated keys."
      },
      "hint": {
        "zh": "先选中文字，再按划词热键；关键字模式读不到其他窗口的选区",
        "en": "Select text, then press the selection hotkey; keyword mode cannot read another window's selection"
      },
      "icon": "glyph:U+E8C1",
      "keyword": [
        "jsel",
        "划词翻译"
      ],
      "mode": "list"
    },
    {
      "id": "clip",
      "title": {
        "zh": "剪贴板翻译",
        "en": "Clipboard translate"
      },
      "description": {
        "zh": "读取剪贴板里的文字并翻译；也可以在关键字后直接输入要翻译的文字。",
        "en": "Translate the text on the clipboard, or type the text after the keyword."
      },
      "hint": {
        "zh": "留空读取剪贴板；也可以直接输入要翻译的文字",
        "en": "Leave it empty to read the clipboard, or type the text to translate"
      },
      "icon": "glyph:U+E8C1",
      "keyword": [
        "jft",
        "剪贴板翻译"
      ],
      "mode": "list",
      "actions": [
        {
          "id": "copy-translation",
          "title": {
            "zh": "复制译文",
            "en": "Copy translation"
          },
          "key": "Enter"
        },
        {
          "id": "copy-source",
          "title": {
            "zh": "复制原文",
            "en": "Copy source"
          },
          "key": "Ctrl+Enter"
        },
        {
          "id": "retry-clip",
          "title": {
            "zh": "重新读取剪贴板",
            "en": "Read the clipboard again"
          },
          "key": "Shift+Enter"
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "provider",
      "type": "choice",
      "title": {
        "zh": "翻译渠道",
        "en": "Translation service"
      },
      "default": "mymemory",
      "options": [
        {
          "value": "mymemory",
          "title": {
            "zh": "MyMemory",
            "en": "MyMemory"
          }
        },
        {
          "value": "google",
          "title": {
            "zh": "Google",
            "en": "Google"
          }
        },
        {
          "value": "edge",
          "title": {
            "zh": "Edge",
            "en": "Edge"
          }
        },
        {
          "value": "zvo",
          "title": {
            "zh": "translate.js",
            "en": "translate.js"
          }
        },
        {
          "value": "sogou",
          "title": {
            "zh": "搜狗",
            "en": "Sogou"
          }
        },
        {
          "value": "youdao",
          "title": {
            "zh": "有道",
            "en": "Youdao"
          }
        },
        {
          "value": "ecdict",
          "title": {
            "zh": "ECDICT",
            "en": "ECDICT"
          }
        },
        {
          "value": "microsoft",
          "title": {
            "zh": "微软",
            "en": "Microsoft"
          }
        },
        {
          "value": "deepl",
          "title": {
            "zh": "DeepL",
            "en": "DeepL"
          }
        },
        {
          "value": "ai",
          "title": {
            "zh": "AI 翻译",
            "en": "AI translation"
          }
        }
      ],
      "presentation": "exclusive"
    },
    {
      "key": "proxy",
      "type": "text",
      "title": {
        "zh": "共用代理",
        "en": "Shared proxy"
      },
      "hint": {
        "zh": "所有翻译渠道共用；HTTP / HTTPS 地址，不含账号密码。留空使用环境或系统代理",
        "en": "Shared by all services; an HTTP/HTTPS URL without credentials. Empty uses environment or system proxy"
      },
      "default": ""
    },
    {
      "key": "fallbackEnabled",
      "type": "bool",
      "title": {
        "zh": "自动降级",
        "en": "Automatic fallback"
      },
      "hint": {
        "zh": "记住暂时失败的渠道，使用其他免费渠道或已配置的服务；不会改变选定的主渠道",
        "en": "Remember unavailable services and use another free or configured service without changing the preferred service"
      },
      "default": true
    },
    {
      "key": "fallbackRecoveryMinutes",
      "type": "number",
      "title": {
        "zh": "自动恢复间隔（分钟）",
        "en": "Recovery interval (minutes)"
      },
      "hint": {
        "zh": "1–1440 分钟。间隔到后，在下一次翻译中优先重试主渠道；修改地址、密钥或代理会立即重试",
        "en": "1–1440 minutes. Retry the preferred service on the next translation after this interval; changed configuration retries immediately"
      },
      "default": 10,
      "min": 1,
      "max": 1440
    },
    {
      "key": "comparisonOrder",
      "type": "choice",
      "presentation": "exclusive",
      "title": {
        "zh": "双语对照顺序",
        "en": "Comparison order"
      },
      "hint": {
        "zh": "上下排列，保留原文与译文的图片布局",
        "en": "Stack the original and translated images vertically"
      },
      "default": "translation-first",
      "options": [
        {
          "value": "translation-first",
          "title": {
            "zh": "译文在上",
            "en": "Translation first"
          }
        },
        {
          "value": "source-first",
          "title": {
            "zh": "原文在上",
            "en": "Source first"
          }
        }
      ]
    },
    {
      "key": "closeOnOutsideClick",
      "type": "bool",
      "title": {
        "zh": "点击其他区域关闭贴图",
        "en": "Close the pin on outside click"
      },
      "hint": {
        "zh": "贴图、工具条、语言菜单和渠道配置窗口内的点击会保留贴图",
        "en": "Clicks inside the pin, toolbar, language menus or service settings keep it open"
      },
      "default": true
    },
    {
      "key": "target",
      "type": "choice",
      "title": {
        "zh": "目标语言",
        "en": "Target language"
      },
      "hint": {
        "zh": "自动：中文译成英文，其他译成中文",
        "en": "Automatic: Chinese to English, anything else to Chinese"
      },
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "title": {
            "zh": "自动",
            "en": "Automatic"
          }
        },
        {
          "value": "zh",
          "title": {
            "zh": "中文",
            "en": "Chinese"
          }
        },
        {
          "value": "en",
          "title": {
            "zh": "英文",
            "en": "English"
          }
        },
        {
          "value": "ja",
          "title": {
            "zh": "日文",
            "en": "Japanese"
          }
        }
      ]
    },
    {
      "key": "shotMode",
      "type": "choice",
      "title": {
        "zh": "全屏截图范围",
        "en": "Full-screen range"
      },
      "hint": {
        "zh": "框选始终覆盖所有显示器；这里只影响 Ctrl+Enter 的全屏截图",
        "en": "Region selection always spans all monitors; this only affects the Ctrl+Enter full-screen capture"
      },
      "default": "multi",
      "options": [
        {
          "value": "multi",
          "title": {
            "zh": "多屏截图（所有显示器）",
            "en": "All monitors"
          }
        },
        {
          "value": "single",
          "title": {
            "zh": "单屏截图（仅鼠标所在屏幕）",
            "en": "Only the monitor with the pointer"
          }
        }
      ]
    },
    {
      "key": "shotHotkey",
      "type": "hotkey",
      "title": {
        "zh": "截图翻译热键",
        "en": "Screenshot hotkey"
      },
      "hint": {
        "zh": "清空即关闭；旧版 Win顺 不支持插件热键时仍可用关键字 jst",
        "en": "Clear to disable; on older WinShun versions use the jst keyword"
      },
      "default": "Alt+Shift+T"
    },
    {
      "key": "clipHotkey",
      "type": "hotkey",
      "title": {
        "zh": "剪贴板翻译热键",
        "en": "Clipboard hotkey"
      },
      "hint": {
        "zh": "在鼠标附近打开词义窗口；清空关闭",
        "en": "Open a word popup near the pointer; clear to disable"
      },
      "default": "Alt+Shift+C"
    },
    {
      "key": "selectionHotkey",
      "type": "hotkey",
      "title": {
        "zh": "划词翻译热键",
        "en": "Selection hotkey"
      },
      "hint": {
        "zh": "在选区旁显示词义；固定后跟随新选区。读取管理员程序需以管理员启动 WinShun 并确认本插件权限",
        "en": "Show a popup by the selection; pin to follow. For elevated apps, run WinShun as administrator and confirm this plugin's permissions"
      },
      "default": "Alt+Shift+W"
    },
    {
      "key": "wordOcrHotkey",
      "type": "hotkey",
      "title": {
        "zh": "鼠标指词 OCR 热键",
        "en": "Pointer word OCR hotkey"
      },
      "hint": {
        "zh": "混排时，少数语言只取所在片段，主要语言取整句；原文可编辑，清空热键关闭",
        "en": "In mixed text, point at a minority language for that phrase or the main language for the sentence; source is editable; clear to disable"
      },
      "default": "Alt+Shift+O"
    }
  ]
}
